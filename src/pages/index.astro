	}
	.marquee-side svg {
		width: 120px;
		transform: rotate(7deg);
	}
	.marquee-side > span {
		font: 9px/1.8 var(--mono);
		letter-spacing: 0.13em;
		text-align: center;
		color: #b9a3c4;
	}
	.arcade-cabinet {
		max-width: 920px;
		margin: auto;
		background: #382a42;
		border: 1px solid #67516f;
		border-radius: 18px 18px 5px 5px;
		padding: 24px 35px 0;
		box-shadow: 0 25px 60px #0006;
	}
	.cabinet-sign {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		background: #d0e05c;
		color: #26320e;
		padding: 20px 25px;
		border-radius: 8px 8px 2px 2px;
		margin-bottom: 20px;
		border: 4px solid #211b2a;
	}
	.cabinet-sign > span:first-child {
		font: 800 29px var(--mono);
		letter-spacing: 0.1em;
	}
	.cabinet-sign > span:last-child {
		font: 9px var(--mono);
		text-align: right;
		line-height: 1.6;
	}
	.cabinet-screen {
		background: #000;
		border: 14px solid #17131e;
		border-radius: 20px;
		box-shadow:
			inset 0 0 20px #000,
			0 2px 0 #695472;
		overflow: hidden;
		display: flex;
		justify-content: center;
		padding: 18px 0;
	}
	.cabinet-screen pre {
		font: 12px/1 var(--mono);
		white-space: pre;
		margin: 0;
		overflow-wrap: normal;
		letter-spacing: 0;
	}
	.cabinet-controls {
		display: flex;
		align-items: center;
		gap: 25px;
		padding: 30px 12px;
	}
	.joystick {
		position: relative;
		width: 65px;
		height: 25px;
		border-radius: 50%;
		background: #1f1827;
		border: 3px solid #53405e;
	}
