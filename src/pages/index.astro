---
import Full from '../layouts/Full.astro';
import octicons from '@primer/octicons';

// The frames are captures, not mock-ups: termcade was run in a pty, the ANSI
// it wrote was replayed cell for cell, and each file below is one screen as it
// came out. See the README for how they were taken and what is in them.
import asteroidFrame from '../frames/asteroid.html?raw';
import indexFrame from '../frames/index-screen.html?raw';
import quadFrame from '../frames/pixels-quad.html?raw';
import sextantFrame from '../frames/pixels-sextant.html?raw';
import halfFrame from '../frames/pixels-half.html?raw';
import asciiFrame from '../frames/pixels-ascii.html?raw';

// Each capture file ends in a newline, as a text file should. Inside a <pre>
// that newline is a blank terminal row at the bottom of the frame.
const frame = (captured: string) => captured.replace(/\n+$/, '');

const asteroid = frame(asteroidFrame);
const indexScreen = frame(indexFrame);

const repo = 'https://github.com/aviorstudio/termcade';
const releases = 'https://github.com/aviorstudio/termcade/releases';
const docs = 'https://github.com/aviorstudio/termcade/blob/main/docs';
const icon = (name: keyof typeof octicons, size = 16) => octicons[name].toSVG({ width: size, height: size });

// Every game in the starter pack. They are packages embedded in the binary,
// not game code compiled into the host, and run through the same wasm boundary
// as anything added from the marketplace.
const games = [
	{
		name: 'ASTEROID',
		from: 'Bundled',
		blurb:
			'Asteroids-style rock shooter. An inertial ship on a wrapping field, and big rocks that split into faster small ones.',
	},
	{
		name: 'TETRIS',
		from: 'Bundled',
		blurb:
			'Falling-block stacker with Super Rotation System kicks, a 7-bag randomizer, ghost piece, lock delay, and gravity that tightens by level.',
	},
	{
		name: 'BRICKOUGH',
		from: 'Bundled',
		blurb: 'Breakout-style brick breaker: steer the ball with paddle english, clear the wall, survive the speed-up.',
	},
];

// The four pixel styles, each shown as the same ship at the same cells of the
// same screen — Asteroid's ship sits dead centre at the start of a wave, so
// four runs put it in exactly the same place and only the glyphs move. The
// values and the grids are TERMCADE_PIXELS' own.
const pixelStyles = [
	{
		value: 'quad',
		grid: '2×2',
		note: 'Unicode 1.0 block elements. Renders anywhere, and the default.',
		frame: frame(quadFrame),
	},
	{
		value: 'sextant',
		grid: '2×3',
		note: 'Sharpest, near-square pixels. Needs Unicode 13, or you get tofu.',
		frame: frame(sextantFrame),
	},
	{
		value: 'half',
		grid: '1×2',
		note: 'The original look, for fonts that struggle with the rest.',
		frame: frame(halfFrame),
	},
	{
		value: 'ascii',
		grid: '3×3',
		note: 'A density ramp and line characters. No block glyphs at all.',
		frame: frame(asciiFrame),
	},
];

const commands = [
	{ cmd: 'termcade', what: 'open the arcade on Marketplace; Ctrl+N opens the sidebar' },
	{ cmd: 'termcade add author/slug', what: 'add a marketplace game to your account and this machine' },
	{ cmd: 'termcade list', what: 'what is in your arcade' },
	{ cmd: 'termcade remove author/slug', what: 'take one off, and off your synced library' },
	{ cmd: 'termcade signup', what: 'create an account — or termcade login, termcade logout' },
	{ cmd: 'termcade dev new you/mygame', what: 'scaffold a game that is already playable' },
	{ cmd: 'termcade dev build', what: 'package a game directory into a .tcade' },
	{ cmd: 'termcade dev install build/game.tcade', what: 'install a local package while developing' },
];

// What a game author is committing to. All of it is in sdk/game.go and
// sdk/input.go, which between them are also the whole dependency list.
const contract = [
	{
		term: 'Ticks',
		def: 'Update() runs exactly 60 times a second, stepped off the measured clock rather than drifting',
	},
	{
		term: 'Input',
		def: 'four directions, two action buttons and start — with real releases where the terminal sends them',
	},
	{ term: 'Drawing', def: 'a canvas in square logical units; the game never sees the pixel grid it lands on' },
	{ term: 'HUD', def: 'labelled fields and a hint. The shell owns every pixel of the styling' },
	{ term: 'Dependencies', def: 'the sdk module, which depends on nothing outside the standard library' },
	{ term: 'Boundary', def: 'wasm ABI v1, frozen. A host refuses a guest whose version it does not speak' },
];
---

<Full>
	<div class="folio">
		<header class="topbar">
			<a class="wordmark" href="/">
				termcade
			</a>
			<nav aria-label="Main">
				<a href="#games">The games</a>
				<a href="#sdk">Build a game</a>
				<a href="https://app.termca.de">Play in browser ↗</a>
			</nav>
		</header>
		<main id="main-content">
			<section class="hero">
				<div class="arcade-marquee">
					<p class="tag">THE TERMINAL ARCADE / OPEN FOR PLAY</p>
					<h1>
						One more
						<br />
						<em>game.</em>
					</h1>
					<div class="marquee-side">
						<svg viewBox="0 0 100 80" aria-hidden="true">
							<path
								d="M20 0h10v10H20ZM70 0h10v10H70ZM30 10h40v10H30ZM10 20h80v10H10ZM0 30h100v30H0ZM10 60h20v10H10ZM70 60h20v10H70ZM30 70h40v10H30Z"
								fill="#d0e05c"
							/>
							<path d="M20 30h20v10H20ZM60 30h20v10H60Z" fill="#1b1725" />
						</svg>
						<span>
							THREE CLASSICS
							<br />
							ONE COMMAND
						</span>
					</div>
				</div>
				<div class="arcade-cabinet">
					<div class="cabinet-sign">
						<span>ASTEROID</span>
						<span>PLAYER 01 / TERMINAL CAPTURE</span>
					</div>
					<div class="cabinet-screen">
						<pre set:html={asteroid} />
					</div>
					<div class="cabinet-controls">
						<div class="joystick" aria-hidden="true">
							<i></i>
						</div>
						<div class="button-pair" aria-hidden="true">
							<i></i>
							<i></i>
						</div>
						<a href="https://app.termca.de">PLAY IN YOUR BROWSER ↗</a>
					</div>
				</div>
				<div class="arcade-intro">
					<p>
						Asteroid, Tetris and Brickough, rendered in Unicode pixels. A small arcade for the terminal you already
						have.
					</p>
					<div>
						<code>go run github.com/aviorstudio/termcade@latest</code>
						<span>TRUECOLOR TERMINAL / 80×24 OR LARGER / PLAY OFFLINE</span>
					</div>
				</div>
			</section>
			<section class="games" id="games">
				<div class="section-head">
					<p class="tag">IN THE STARTER PACK</p>
					<h2 class="section-heading">
						Pick your
						<br />
						next high score.
					</h2>
				</div>
				<ul class="game-list">
					{games.map((game, index) => (
						<li>
							<span class="game-number">0{index + 1}</span>
							<div class="game-symbol" aria-hidden="true">
								{index === 0 ? '△' : index === 1 ? '▟' : '▦'}
							</div>
							<h3>{game.name}</h3>
							<p>{game.blurb}</p>
							<span class="bundled">BUNDLED / PLAY OFFLINE</span>
						</li>
					))}
				</ul>
			</section>
			<section class="pixels">
				<div class="section-head wide">
					<p class="eyebrow">
						<span></span> TERMCADE_PIXELS
					</p>
					<h2>One ship. Four ways to cut up a cell.</h2>
					<p>
						Every setting draws the same game into the same terminal cells; only the sharpness, and what the font has to
						know how to draw, change. Below is Asteroid's ship at the start of a wave, captured four times over and
						blown up — the same five columns of cells every time, a different number of pixels inside them. In the
						arcade <code>p</code> cycles the style and keeps it, and <code>TERMCADE_PIXELS</code> overrides the saved
						choice for a single run.
					</p>
				</div>
				<div class="pixel-grid">
					{pixelStyles.map((style) => (
						<figure>
							<div class="pixel-frame">
								<pre set:html={style.frame} />
							</div>
							<figcaption>
								<b>{style.value}</b>
								<span>{style.grid} per cell</span>
								<p>{style.note}</p>
							</figcaption>
						</figure>
					))}
				</div>
			</section>
			<section class="arcade">
				<div class="section-head">
					<p class="eyebrow">
						<span></span> The front door
					</p>
					<h2>Find a game. Make it yours.</h2>
					<p>
						The arcade opens on Marketplace. Use Ctrl+N to open the sidebar and switch to Library. Browse without
						signing in; Add saves a game to your account, while Play downloads and installs it. Your installed games
						stay in Library even when you are signed out.
					</p>
					<p class="aside">
						The live registry is <code>api.termca.de</code>. Package bytes pass through it and are checked against the
						sha256 recorded when the release was published before either the terminal or web app runs them.{' '}
						<code>TERMCADE_REGISTRY</code> selects a local registry for development.
					</p>
				</div>

				<div class="arcade-right">
					<div class="menu-frame">
						<pre set:html={indexScreen} />
					</div>
					<p class="aside">Library capture from an earlier release. Current releases open on Marketplace.</p>
					<table>
						<tbody>
							{commands.map((row) => (
								<tr>
									<th scope="row">
										<code>{row.cmd}</code>
									</th>
									<td>{row.what}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
			<section class="sdk" id="sdk">
				<div class="section-head">
					<p class="eyebrow">
						<span></span> termcade dev
					</p>
					<h2>The arcade you play with is the dev kit.</h2>
					<p>
						<code>termcade dev new you/mygame</code> scaffolds a game that already runs,
						<code>termcade dev build</code> turns the directory into a <code>.tcade</code>, and
						<code>termcade dev install</code> puts the local build on your own menu. A game is a Go package implementing
						one interface — and because the boundary is a frozen wasm ABI rather than a Go one, Go is a convenience and
						not a requirement.
					</p>
					<p class="links">
						<a href={`${docs}/sdk.md`}>
							SDK quickstart <span class="icon" set:html={icon('arrow-up-right', 13)} />
						</a>
						<a href={`${docs}/packaging.md`}>
							Packaging <span class="icon" set:html={icon('arrow-up-right', 13)} />
						</a>
						<a href={`${docs}/abi.md`}>
							The wasm ABI <span class="icon" set:html={icon('arrow-up-right', 13)} />
						</a>
					</p>
				</div>
				<dl class="contract">
					{contract.map((row) => (
						<div>
							<dt>{row.term}</dt>
							<dd>{row.def}</dd>
						</div>
					))}
				</dl>
			</section>
			<section class="closing">
				<p class="tag">THREE GAMES IN THE BOX. THE REST IS YOURS.</p>
				<h2 class="section-heading">
					The arcade you play with
					<br />
					is the dev kit.
				</h2>
				<div>
					<a class="cta" href={releases}>
						Get the binary ↗
					</a>
					<a href={`${docs}/sdk.md`}>Make your own game ↗</a>
				</div>
				<p>Sandboxed WebAssembly games. A fixed 60-tick update loop. Four directions, two action buttons and start.</p>
			</section>
		</main>
		<footer class="bottom">
			<span>termcade / by Avior Studio</span>
			<nav aria-label="Footer">
				<a href="https://github.com/aviorstudio/termcade">Source</a>
				<a href="https://app.termca.de">Play</a>
			</nav>
		</footer>
	</div>
</Full>
<style>
	* {
		box-sizing: border-box;
	}
	a {
		color: inherit;
		text-underline-offset: 5px;
	}
	img {
		max-width: 100%;
	}
	svg {
		max-width: 100%;
	}
	h1,
	h2,
	h3,
	p {
		overflow-wrap: break-word;
	}
	h1,
	h2,
	h3 {
		text-wrap: balance;
	}
	p {
		line-height: 1.7;
	}
	code,
	pre {
		font-family: var(--mono);
	}
	pre {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.folio {
		width: min(1200px, calc(100% - 64px));
		margin: auto;
	}
	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		min-height: 100px;
	}
	.wordmark {
		font-size: 23px;
		font-weight: 750;
		letter-spacing: -0.04em;
		text-decoration: none;
	}
	.topbar nav {
		display: flex;
		gap: 25px;
		align-items: center;
		font-size: 12px;
	}
	.topbar nav a {
		text-decoration: none;
	}
	.tag {
		font: 11px var(--mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
		padding: 18px 25px;
		font-size: 14px;
		font-weight: 650;
		text-decoration: none;
		border-radius: 4px;
	}
	.bottom {
		padding: 35px 0;
		display: flex;
		justify-content: space-between;
		gap: 20px;
		align-items: center;
		font-size: 12px;
		border-top: 1px solid var(--line);
	}
	.bottom nav {
		display: flex;
		gap: 20px;
	}
	.section-heading {
		font-size: clamp(32px, 4vw, 52px);
		letter-spacing: -0.04em;
		font-weight: 550;
		line-height: 1.1;
	}
	.card-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 25px;
	}
	.card-grid h3 {
		font-size: 22px;
		font-weight: 600;
		letter-spacing: -0.025em;
	}
	.card-grid p {
		font-size: 14px;
	}
	.icon svg {
		width: 16px;
		height: 16px;
		fill: currentColor;
	}
	details summary {
		cursor: pointer;
		padding: 20px 0;
		font-size: 16px;
	}
	details {
		border-top: 1px solid var(--line);
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13px;
	}
	th,
	td {
		text-align: left;
		padding: 15px;
		border-bottom: 1px solid var(--line);
		overflow-wrap: anywhere;
	}
	th {
		font-weight: 600;
	}
	main > section {
		margin-bottom: 100px;
	}
	.source-label {
		font: 10px var(--mono);
		letter-spacing: 0.06em;
	}
	a:focus-visible,
	summary:focus-visible {
		outline: 3px solid currentColor;
		outline-offset: 5px;
	}
	@media (max-width: 900px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
		main > section {
			margin-bottom: 70px;
		}
	}
	@media (max-width: 600px) {
		.folio {
			width: calc(100% - 36px);
		}
		.topbar {
			min-height: 85px;
			gap: 16px;
			flex-wrap: wrap;
			padding: 20px 0;
		}
		.topbar nav {
			gap: 16px;
			font-size: 11px;
		}
		.wordmark {
			font-size: 21px;
		}
		.bottom {
			flex-wrap: wrap;
		}
		.cta {
			padding: 16px 20px;
		}
		th,
		td {
			padding: 12px 7px;
			font-size: 11px;
		}
		main > section {
			margin-bottom: 55px;
		}
	}
	.folio {
		max-width: 1180px;
	}
	.topbar {
		border-bottom: 1px solid #45384d;
	}
	.wordmark {
		font-family: var(--mono);
		color: #d0e05c;
		font-size: 21px;
	}
	.topbar nav {
		color: #c9b6d0;
	}
	.hero {
		padding: 45px 0 0;
	}
	.arcade-marquee {
		position: relative;
		margin: auto;
		max-width: 920px;
		padding: 15px 0 40px;
	}
	.arcade-marquee .tag {
		color: #b9a3c4;
		font-size: 10px;
	}
	.arcade-marquee h1 {
		font: 800 clamp(70px, 10vw, 138px)/0.84 var(--sans);
		text-transform: uppercase;
		letter-spacing: -0.06em;
		margin: 35px 0 10px;
		color: #ede5dd;
	}
	.arcade-marquee h1 em {
		font-style: normal;
		color: #d0e05c;
		text-shadow: 0 0 40px #d0e05c20;
	}
	.marquee-side {
		position: absolute;
		right: 35px;
		bottom: 50px;
		display: flex;
		align-items: center;
		flex-direction: column;
